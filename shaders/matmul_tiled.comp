#version 450

// Tiled matmul: 16x16 workgroup cooperatively loads tiles of A and B
// into shared memory. Each thread computes one element of a 16x16
// output tile. Memory traffic: O(M*N*K/TILE) vs O(M*N*K) naive.

#define TILE 16

layout (local_size_x = TILE, local_size_y = TILE) in;

layout (std430, binding = 0) readonly buffer A_buf { float A[]; };
layout (std430, binding = 1) readonly buffer B_buf { float B[]; };
layout (std430, binding = 2) writeonly buffer C_buf { float C[]; };

layout (push_constant) uniform Push {
    uint M;
    uint N;
    uint K;
} pc;

shared float tile_A[TILE][TILE];
shared float tile_B[TILE][TILE];

void main() {
    uint row = gl_WorkGroupID.y * TILE + gl_LocalInvocationID.y;
    uint col = gl_WorkGroupID.x * TILE + gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;
    uint tx = gl_LocalInvocationID.x;

    float acc = 0.0;

    uint num_tiles = (pc.K + TILE - 1u) / TILE;

    for (uint t = 0u; t < num_tiles; t++) {
        // Cooperative load: each thread loads one element of each tile
        uint a_col = t * TILE + tx;
        uint b_row = t * TILE + ty;

        // Boundary check: zero-pad for non-multiple-of-TILE dims
        tile_A[ty][tx] = (row < pc.M && a_col < pc.K)
                         ? A[row * pc.K + a_col] : 0.0;
        tile_B[ty][tx] = (b_row < pc.K && col < pc.N)
                         ? B[b_row * pc.N + col] : 0.0;

        barrier();

        // Accumulate tile product
        for (uint k = 0u; k < TILE; k++) {
            acc += tile_A[ty][k] * tile_B[k][tx];
        }

        barrier();
    }

    if (row < pc.M && col < pc.N) {
        C[row * pc.N + col] = acc;
    }
}
