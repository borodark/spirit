#version 450

layout (local_size_x = 256) in;

// Specialization constant selects operation at pipeline creation.
// Switch eliminated by SPIR-V compiler — zero runtime cost.
layout (constant_id = 0) const int OP = 0;

// Push constant: number of elements
layout (push_constant) uniform Push {
    uint n;
} pc;

layout (std430, binding = 0) readonly buffer InputA { float a[]; };
layout (std430, binding = 1) readonly buffer InputB { float b[]; };
layout (std430, binding = 2) writeonly buffer Output { float c[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;

    float x = a[i];
    float y = b[i];
    float r;

    switch (OP) {
        case 0: r = x + y; break;        // add
        case 1: r = x * y; break;        // multiply
        case 2: r = x - y; break;        // subtract
        case 3: r = x / y; break;        // divide
        case 4: r = pow(x, y); break;    // power
        case 5: r = max(x, y); break;    // max
        case 6: r = min(x, y); break;    // min
        default: r = 0.0; break;
    }

    c[i] = r;
}
