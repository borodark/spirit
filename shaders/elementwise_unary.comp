#version 450

layout (local_size_x = 256) in;

// Specialization constant selects op at pipeline creation
layout (constant_id = 0) const int OP = 0;

layout (push_constant) uniform Push {
    uint n;
} pc;

layout (std430, binding = 0) readonly buffer Input { float in_data[]; };
layout (std430, binding = 1) writeonly buffer Output { float out_data[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;

    float x = in_data[i];
    float y;

    switch (OP) {
        case 0: y = exp(x); break;
        case 1: y = log(x); break;
        case 2: y = sqrt(x); break;
        case 3: y = abs(x); break;
        case 4: y = -x; break;
        case 5: y = 1.0 / (1.0 + exp(-x)); break;  // sigmoid
        case 6: y = tanh(x); break;
        case 7: y = max(x, 0.0); break;             // relu
        case 8: y = ceil(x); break;
        case 9: y = floor(x); break;
        case 10: y = sign(x); break;
        case 11: y = 1.0 / x; break;                // reciprocal
        case 12: y = x * x; break;                   // square
        default: y = x; break;
    }

    out_data[i] = y;
}
